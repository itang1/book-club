# Supabase credentials for Sisterhood of the Traveling Books
# Copy this file to .env and fill in your project values:
#   cp .env.example .env
#
# The app runs on seeded mock data when these are left blank.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the web build is hosted. Used for invite links; defaults to the
# GitHub Pages address in the README.
EXPO_PUBLIC_APP_URL=

# Show the dev-mode profile switcher in an exported build too (always on
# under `expo start`). Leave unset for real use.
EXPO_PUBLIC_DEV_MODE=
