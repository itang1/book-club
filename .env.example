# Supabase credentials for Sisterhood of the Traveling Books
# Copy this file to .env and fill in your project values:
#   cp .env.example .env
#
# The app runs on seeded mock data when these are left blank.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
