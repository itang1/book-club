{
  "name": "book-club",
  "version": "1.0.0",
  "private": true,
  "description": "Read it, write in it, and pass it on: one copy of a book travels a circle of friends, and the app keeps its journey.",
  "homepage": "https://itang1.github.io/book-club",
  "repository": {
    "type": "git",
    "url": "https://github.com/itang1/book-club.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --clear",
    "demo": "EXPO_NO_DOTENV=1 expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample:sql": "WRITE_SAMPLE_SQL=1 vitest run src/data/sampleSql.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "supabase/tests/run.sh",
    "icons": "node scripts/icons.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.0.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-picker": "^57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
